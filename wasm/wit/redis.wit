package redis-module-wasm:host@0.1.0;

/// What the host gives a guest.
interface redis {
    /// One node of a reply, in pre-order. WIT has no recursive types, so an
    /// aggregate node carries its element count and its elements follow it:
    /// `array(n)` and `set(n)` are followed by n nodes, `map(n)` by n key and
    /// value pairs (2n nodes).
    variant node {
        nil,
        integer(s64),
        double(f64),
        boolean(bool),
        simple(string),
        bulk(list<u8>),
        error(string),
        array(u32),
        set(u32),
        map(u32),
    }

    /// Where a string lies in a `flat-reply`'s `data`.
    record span {
        offset: u32,
        len: u32,
    }

    /// A node of a `flat-reply`: a `node` whose strings are spans of the
    /// reply's `data`.
    variant flat-node {
        nil,
        integer(s64),
        double(f64),
        boolean(bool),
        simple(span),
        bulk(span),
        error(span),
        array(u32),
        set(u32),
        map(u32),
    }

    /// A reply in two buffers: the nodes in pre-order, as `call` returns them,
    /// and the bytes of all their strings. Moving it into the guest takes two
    /// allocations instead of one per string, which matters for a reply with
    /// many strings.
    record flat-reply {
        nodes: list<flat-node>,
        data: list<u8>,
    }

    enum log-level {
        debug,
        verbose,
        notice,
        warning,
    }

    /// Runs a Redis command, like `redis.call`: an error reply fails the
    /// function, which replies with that error.
    call: func(command: string, args: list<list<u8>>) -> list<node>;

    /// Runs a Redis command, like `redis.pcall`: an error reply comes back as
    /// an `error` node.
    pcall: func(command: string, args: list<list<u8>>) -> list<node>;

    /// `call`, with the reply flat.
    call-flat: func(command: string, args: list<list<u8>>) -> flat-reply;

    /// `pcall`, with the reply flat.
    pcall-flat: func(command: string, args: list<list<u8>>) -> flat-reply;

    /// Whether the user running the function may run the command with these
    /// arguments, like `redis.acl_check_cmd`. An unknown command is an error.
    acl-check-command: func(command: string, args: list<list<u8>>) -> result<bool, string>;

    /// Sets the protocol of the replies `call` and `pcall` return, 2 or 3,
    /// like `redis.setresp`. Each call of a function starts with 3, so the
    /// guest sees each reply's type; Lua starts with 2. Another version fails
    /// the function.
    set-resp: func(version: u8);

    /// Writes to the server log.
    log: func(level: log-level, message: string);
}

/// A library of functions, like one loaded with `FUNCTION LOAD`.
world library {
    import redis;
    use redis.{node};

    /// What a function may do: the flags of a Lua function.
    flags function-flags {
        /// The function does not write. It may run from `WASM.CALL_RO`, on a
        /// read-only replica and over `maxmemory`; a write command it calls
        /// fails.
        no-writes,
        /// A function that writes may start over `maxmemory`, and the commands
        /// it calls are not checked against it.
        allow-oom,
        /// The function may run on a replica whose link to its primary is down
        /// while `replica-serve-stale-data` is `no`.
        allow-stale,
        /// The function does not run on a cluster node.
        no-cluster,
        /// On a cluster node, the commands the function calls may use keys in
        /// any slot this node serves, not only one slot.
        allow-cross-slot-keys,
    }

    /// A function's name and flags.
    record function {
        name: string,
        %flags: function-flags,
    }

    /// The functions this library provides.
    export functions: func() -> list<function>;

    /// Runs function `name` with its keys and arguments, and returns the reply.
    export invoke: func(name: string, keys: list<list<u8>>, args: list<list<u8>>) -> list<node>;
}

/// The host's interface alone, for a library that guests share, such as
/// `guest-sdk`, so that their bindings use its types.
world guest-imports {
    import redis;
}
